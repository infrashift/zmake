# zmake development gates in modern mode. The same targets as the Makefile,
# with no .PHONY list: `@name:` declares each task. zmake reads this file
# before the Makefile. GNU Make reads the Makefile.

ZIG ?= zig
PYTHON ?= python3
SEMSCOPE ?= semscope
VERSION ?=
ZIG_SOURCES := build.zig src tests
MAN_PAGES := man/zmake.1 man/zmakefile.5

## all: run every gate (the default goal)
@all: check

## build: compile the zmake binary into zig-out/bin
@build:
    $(ZIG) build

## test: run the unit tests and the mode tests
@test:
    $(ZIG) build test --summary all

## lint: check the formatting, the Power of 10 rules (semscope, else scripts/nasa-lint.py) and the man pages
@lint:
    $(ZIG) fmt --check $(ZIG_SOURCES)
    if command -v $(SEMSCOPE) >/dev/null 2>&1; then $(SEMSCOPE) scan -r nasa-p10 -r .semscope.cue --fail-level warning src; else echo "lint: $(SEMSCOPE) not found, so scripts/nasa-lint.py checks the rules"; $(PYTHON) -I scripts/nasa-lint.py; fi
    for page in $(MAN_PAGES); do if command -v mandoc >/dev/null 2>&1; then mandoc -T lint -W warning "$$page" || exit 1; else out=$$(groff -mandoc -ww -z "$$page" 2>&1); [ -z "$$out" ] || { echo "$$page: $$out"; exit 1; }; fi; done

## fmt: format the Zig sources in place
@fmt:
    $(ZIG) fmt $(ZIG_SOURCES)

## acceptance: run the end-to-end scenarios against the built binary
@acceptance:
    $(ZIG) build acceptance

## cross: build for macOS and FreeBSD on arm64 and x86_64, and for Windows on x86_64 (ADR-0020, ADR-0029)
@cross:
    $(ZIG) build -Dtarget=aarch64-macos --prefix zig-out/cross/aarch64-macos
    $(ZIG) build -Dtarget=x86_64-macos --prefix zig-out/cross/x86_64-macos
    $(ZIG) build -Dtarget=aarch64-freebsd --prefix zig-out/cross/aarch64-freebsd
    $(ZIG) build -Dtarget=x86_64-freebsd --prefix zig-out/cross/x86_64-freebsd
    $(ZIG) build -Dtarget=x86_64-windows --prefix zig-out/cross/x86_64-windows

## wiki: validate the OKF wiki
@wiki:
    okfw validate --all
    okfw validate --okf

## docs-style: check the documentation against ASD-STE100 rules
@docs-style:
    $(PYTHON) -I scripts/ste-check.py

## docs-demo: regenerate the landing-page demo output with zmake itself
@docs-demo: build
    rm -rf zig-out/docs-demo
    mkdir -p zig-out/docs-demo/build
    cp docs/src/demo/ZMakefile zig-out/docs-demo/
    cd zig-out/docs-demo && touch main.c util.c && ../bin/zmake -n deploy > ../../docs/src/demo/output.txt 2>&1

## docs-dev: run the Astro Starlight site locally (bun)
@docs-dev:
    cd docs && bun install && bun --bun run dev

## docs-build: build the site into docs/dist (the same build as the Pages deploy)
@docs-build:
    cd docs && bun install --frozen-lockfile && bun --bun run build

## check: run every gate
@check: lint test acceptance cross wiki docs-style

## dist: build the release archives and SHA256SUMS in zig-out/dist (ADR-0028)
@dist:
    ZIG=$(ZIG) sh scripts/dist.sh $(VERSION)
